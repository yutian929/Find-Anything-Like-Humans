<launch>
    <!-- 获取环境变量 -->
    <arg name="yolo_world_venv" default="/home/$(env USER)/miniconda3/envs/py310/bin/python" doc=""/>
    <env name="LD_PRELOAD" value="/usr/lib/x86_64-linux-gnu/libtiff.so.5"/>
    
    <arg name="model_path" default="$(find yolo_world_pkg)/scripts/weights/yolov8l-worldv2.pt" doc=""/>
    <arg name="box_threshold" default="0.25" doc=""/>
    <!-- 节点 -->
    <node name="yolo_world_node"
          pkg="yolo_world_pkg"
          type="yolo_world_node.py" 
          launch-prefix="$(arg yolo_world_venv)"
          output="screen"
          respawn="true">
        <param name="model_path" value="$(arg model_path)"/>
        <param name="box_threshold" value="$(arg box_threshold)"/>
    </node>

    <!-- <node name="test"
            pkg="yolo_world_pkg"
            type="test.py" 
            launch-prefix="$(arg yolo_world_venv)"
            output="screen"
            respawn="true">
    </node> -->


</launch>
