<launch>
    <!-- 获取环境变量 -->
    <arg name="dinov2_venv" default="/home/$(env USER)/miniconda3/envs/py310/bin/python" doc=""/>
    <env name="LD_PRELOAD" value="/usr/lib/x86_64-linux-gnu/libtiff.so.5"/>

    <!-- 节点 -->
    <node name="dinov2_node"
          pkg="dinov2_pkg"
          type="dinov2_node.py" 
          launch-prefix="$(arg dinov2_venv)"
          output="screen"
          respawn="true">
    </node>

    <node name="test"
            pkg="dinov2_pkg"
            type="test.py" 
            launch-prefix="$(arg dinov2_venv)"
            output="screen"
            respawn="true">
        <param name="cat_img_path" value="$(find dinov2_pkg)/scripts/cat.jpg"/>
        <param name="dog_img_path" value="$(find dinov2_pkg)/scripts/dog.jpg"/>
    </node>


</launch>
