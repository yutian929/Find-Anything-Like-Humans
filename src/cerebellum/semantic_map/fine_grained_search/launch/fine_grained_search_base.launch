<launch>
    <!-- 获取环境变量 -->
    <arg name="evit_sam_venv" default="/home/$(env USER)/miniconda3/envs/py310/bin/python" doc=""/>
    <arg name="clip_venv" default="/home/$(env USER)/miniconda3/envs/py310/bin/python" doc=""/>
    <arg name="yolo_world_venv" default="/home/$(env USER)/miniconda3/envs/py310/bin/python" doc=""/>
    <!-- <arg name="caod_venv" default="/home/$(env USER)/miniconda3/envs/mvits/bin/python" doc=""/> -->
    <env name="LD_PRELOAD" value="/usr/lib/x86_64-linux-gnu/libtiff.so.5"/>
    <arg name="clip/model_type" default="ViT-B/16" doc=""/>
    <arg name="seg/evit_sam_checkpoint" default="$(find evit_sam_pkg)/scripts/weights/efficientvit_sam_l1.pt" doc=""/>
    <arg name="seg/evit_sam_model" default="efficientvit-sam-l1" doc=""/>
    <arg name="seg/fast_sam_checkpoint" default="$(find evit_sam_pkg)/scripts/weights/FastSAM-x.pt" doc=""/>
    <arg name="det/yolo/model_path" default="$(find yolo_world_pkg)/scripts/weights/yolov8l-worldv2.pt" doc=""/>
    <arg name="det/yolo/box_threshold" default="0.2" doc=""/>
    <arg name="det/yolo/nms_threshold" default="0.5" doc=""/>
    <!-- <arg name="det/caod/model_type" default="mdef_detr_minus_language" doc=""/>
    <arg name="det/caod/model_checkpoints_path" default="$(find caod_pkg)/scripts/weights/MDef_DETR_minus_language_r101_epoch10.pth" doc=""/> -->
    <!-- seg -->
    <node name="sam_node"
          pkg="evit_sam_pkg"
          type="sam_node.py" 
          launch-prefix="$(arg evit_sam_venv)"
          output="screen"
          respawn="true">
        <param name="evit_sam_checkpoint" value="$(arg seg/evit_sam_checkpoint)"/>
        <param name="evit_sam_model" value="$(arg seg/evit_sam_model)"/>
        <param name="fast_sam_checkpoint" value="$(arg seg/fast_sam_checkpoint)"/>
    </node>
    <!-- clip -->
    <node name="clip_node"
          pkg="clip_pkg"
          type="clip_node.py" 
          launch-prefix="$(arg clip_venv)"
          output="screen"
          respawn="true">
        <param name="model_type" value="$(arg clip/model_type)"/>
    </node>
    <!-- det -->
    <node name="yolo_world_node"
          pkg="yolo_world_pkg"
          type="yolo_world_node.py" 
          launch-prefix="$(arg yolo_world_venv)"
          output="screen"
          respawn="true">
        <param name="model_path" value="$(arg det/yolo/model_path)"/>
        <param name="box_threshold" value="$(arg det/yolo/box_threshold)"/>
    </node>
    <!-- <node name="mvits_node"
          pkg="caod_pkg"
          type="mvits_node.py" 
          launch-prefix="$(arg caod_venv)"
          output="screen"
          respawn="true">
        <param name="model_type" value="$(arg det/caod/model_type)"/>
        <param name="model_checkpoints_path" value="$(arg det/caod/model_checkpoints_path)"/>
    </node> -->


</launch>
