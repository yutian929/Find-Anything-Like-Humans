<launch>
    <!-- 获取环境变量 -->
    <arg name="fine_grained_search_venv" default="/home/$(env USER)/miniconda3/envs/py310/bin/python" doc=""/>
    <env name="LD_PRELOAD" value="/usr/lib/x86_64-linux-gnu/libtiff.so.5"/>

    <node name="fine_grained_search_node"
          pkg="fine_grained_search"
          type="fine_grained_search_node.py" 
          launch-prefix="$(arg fine_grained_search_venv)"
          output="screen"
          respawn="true">
    </node>

</launch>
