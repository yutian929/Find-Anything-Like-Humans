<launch>
    <!-- 获取环境变量 -->
    <arg name="dinov3_venv" default="/home/$(env USER)/miniconda3/envs/py310/bin/python" doc=""/>
    <env name="LD_PRELOAD" value="/usr/lib/x86_64-linux-gnu/libffi.so.7"/>
    <!-- <env name="LD_PRELOAD" value="/usr/lib/x86_64-linux-gnu/libtiff.so.5"/> -->

    <!-- 节点 -->
    <node name="dinov3_node"
          pkg="dinov3_pkg"
          type="dinov3_node.py" 
          launch-prefix="$(arg dinov3_venv)"
          output="screen"
          respawn="true">
    </node>

    <node name="test"
            pkg="dinov3_pkg"
            type="test.py" 
            launch-prefix="$(arg dinov3_venv)"
            output="screen"
            respawn="true">
        <param name="cat_img_path" value="$(find dinov3_pkg)/scripts/cat.jpg"/>
        <param name="dog_img_path" value="$(find dinov3_pkg)/scripts/dog.jpg"/>
    </node>


</launch>
